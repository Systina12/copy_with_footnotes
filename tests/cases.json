[
  {
    "name": "basic",
    "source": "Alpha[^a]\n\n[^a]: Source",
    "selection": "Alpha[^a]",
    "expected": "Alpha[^a]\n\n[^a]: Source"
  },
  {
    "name": "multiple",
    "source": "A[^a] B[^b]\n\n[^a]: A\n[^b]: B",
    "selection": "A[^a] B[^b]",
    "expected": "A[^a] B[^b]\n\n[^a]: A\n[^b]: B"
  },
  {
    "name": "repeated reference",
    "source": "A[^x] B[^x]\n\n[^x]: X",
    "selection": "A[^x] B[^x]",
    "expected": "A[^x] B[^x]\n\n[^x]: X"
  },
  {
    "name": "multiline",
    "source": "A[^x]\n\n[^x]: First\n    Second\n    Third",
    "selection": "A[^x]",
    "expected": "A[^x]\n\n[^x]: First\n    Second\n    Third"
  },
  {
    "name": "multiline paragraphs",
    "source": "A[^x]\n\n[^x]: First\n\n    Second\n\nOther",
    "selection": "A[^x]",
    "expected": "A[^x]\n\n[^x]: First\n\n    Second"
  },
  {
    "name": "tab continuation",
    "source": "A[^x]\n\n[^x]: First\n\tSecond",
    "selection": "A[^x]",
    "expected": "A[^x]\n\n[^x]: First\n\tSecond"
  },
  {
    "name": "lazy continuation",
    "source": "A[^x]\n\n[^x]: First\nSecond\n\nOther",
    "selection": "A[^x]",
    "expected": "A[^x]\n\n[^x]: First\nSecond"
  },
  {
    "name": "already included",
    "source": "Text[^a]\n\n[^a]: Source",
    "selection": "Text[^a]\n\n[^a]: Source",
    "expected": "Text[^a]\n\n[^a]: Source"
  },
  {
    "name": "missing",
    "source": "Text[^missing]",
    "selection": "Text[^missing]",
    "expected": "Text[^missing]"
  },
  {
    "name": "recursive",
    "source": "A[^a]\n\n[^a]: B[^b]\n[^b]: C",
    "selection": "A[^a]",
    "expected": "A[^a]\n\n[^a]: B[^b]\n[^b]: C"
  },
  {
    "name": "cycle",
    "source": "A[^a]\n\n[^a]: B[^b]\n[^b]: A[^a]",
    "selection": "A[^a]",
    "expected": "A[^a]\n\n[^a]: B[^b]\n[^b]: A[^a]"
  },
  {
    "name": "self cycle",
    "source": "A[^a]\n\n[^a]: A[^a]",
    "selection": "A[^a]",
    "expected": "A[^a]\n\n[^a]: A[^a]"
  },
  {
    "name": "ordering",
    "source": "[^b] then [^a]\n\n[^a]: A\n[^b]: B",
    "selection": "[^b] then [^a]",
    "expected": "[^b] then [^a]\n\n[^b]: B\n[^a]: A"
  },
  {
    "name": "preorder dependencies",
    "source": "A[^a] C[^c]\n\n[^c]: C\n[^b]: B\n[^a]: B[^b]",
    "selection": "A[^a] C[^c]",
    "expected": "A[^a] C[^c]\n\n[^a]: B[^b]\n[^b]: B\n[^c]: C"
  },
  {
    "name": "code fence",
    "source": "```text\nFake[^x]\n```\n\nReal[^a]\n\n[^a]: Real source.\n[^x]: Fake source.",
    "selection": "```text\nFake[^x]\n```\n\nReal[^a]",
    "expected": "```text\nFake[^x]\n```\n\nReal[^a]\n\n[^a]: Real source."
  },
  {
    "name": "selected fence fragment",
    "source": "```text\nFake[^x]\n```\n\n[^x]: Fake",
    "selection": "Fake[^x]",
    "expected": "Fake[^x]"
  },
  {
    "name": "inline footnote",
    "source": "Text^[This is inline.]",
    "selection": "Text^[This is inline.]",
    "expected": "Text^[This is inline.]"
  },
  {
    "name": "inline code",
    "source": "`Fake[^x]` Real[^a]\n\n[^a]: A\n[^x]: X",
    "selection": "`Fake[^x]` Real[^a]",
    "expected": "`Fake[^x]` Real[^a]\n\n[^a]: A"
  },
  {
    "name": "fenced dependency",
    "source": "A[^x]\n\n[^x]: First\n    ```md\n    Fake[^y]\n    ```\n[^y]: Y",
    "selection": "A[^x]",
    "expected": "A[^x]\n\n[^x]: First\n    ```md\n    Fake[^y]\n    ```"
  },
  {
    "name": "partial definition",
    "source": "A[^x]\n\n[^x]: First\n    Second",
    "selection": "A[^x]\n\n[^x]: Fi",
    "expected": "A[^x]\n\n[^x]: Fi\n\n[^x]: First\n    Second"
  },
  {
    "name": "included recursive parent",
    "source": "A[^a]\n\n[^a]: B[^b]\n[^b]: C",
    "selection": "A[^a]\n\n[^a]: B[^b]",
    "expected": "A[^a]\n\n[^a]: B[^b]\n\n[^b]: C"
  },
  {
    "name": "uppercase labels",
    "source": "A[^ABC]\n\n[^ABC]: Hello",
    "selection": "A[^ABC]",
    "expected": "A[^ABC]\n\n[^ABC]: Hello"
  },
  {
    "name": "blockquote definition",
    "source": "A[^x]\n\n> [^x]: First\n>     Second",
    "selection": "A[^x]",
    "expected": "A[^x]\n\n> [^x]: First\n>     Second"
  },
  {
    "name": "list definition",
    "source": "A[^x]\n\n- [^x]: First\n      Second",
    "selection": "A[^x]",
    "expected": "A[^x]\n\n- [^x]: First\n      Second"
  },
  {
    "name": "indented definition",
    "source": "A[^x]\n\n  [^x]: First\n    Second",
    "selection": "A[^x]",
    "expected": "A[^x]\n\n  [^x]: First\n    Second"
  },
  {
    "name": "CRLF",
    "source": "A[^x]\r\n\r\n[^x]: First\r\n    Second\r\n    Third\r\n",
    "selection": "A[^x]",
    "expected": "A[^x]\r\n\r\n[^x]: First\r\n    Second\r\n    Third"
  },
  {
    "name": "one trailing newline",
    "source": "A[^a]\n\n[^a]: Source",
    "selection": "A[^a]\n",
    "expected": "A[^a]\n\n[^a]: Source"
  },
  {
    "name": "existing blank line",
    "source": "A[^a]\n\n[^a]: Source",
    "selection": "A[^a]\n\n",
    "expected": "A[^a]\n\n[^a]: Source"
  },
  {
    "name": "existing many blank lines",
    "source": "A[^a]\n\n\n\n[^a]: Source",
    "selection": "A[^a]\n\n\n\n",
    "expected": "A[^a]\n\n\n\n[^a]: Source"
  },
  {
    "name": "whitespace blank line",
    "source": "  A[^a]  \n  \n[^a]: Source",
    "selection": "  A[^a]  \n  \n",
    "expected": "  A[^a]  \n  \n[^a]: Source"
  },
  {
    "name": "no footnotes",
    "source": "Hello world",
    "selection": "Hello world",
    "expected": "Hello world"
  },
  {
    "name": "empty selection",
    "source": "A[^a]\n\n[^a]: Source",
    "selection": "",
    "expected": ""
  },
  {
    "name": "partial reference",
    "source": "A[^a]\n\n[^a]: Source",
    "selection": "A[^a",
    "expected": "A[^a"
  },
  {
    "name": "escaped reference",
    "source": "Fake\\[^x] Real[^a]\n\n[^a]: A\n[^x]: X",
    "selection": "Fake\\[^x] Real[^a]",
    "expected": "Fake\\[^x] Real[^a]\n\n[^a]: A"
  },
  {
    "name": "unfinished whitespace blank line",
    "source": "A[^a]\n\n    \n[^a]: Source",
    "selection": "A[^a]\n\n    ",
    "expected": "A[^a]\n\n    \n[^a]: Source"
  },
  {
    "name": "missing recursive dependency",
    "source": "A[^a]\n\n[^a]: See [^missing].",
    "selection": "A[^a]",
    "expected": "A[^a]\n\n[^a]: See [^missing]."
  },
  {
    "name": "conflicting duplicate definitions are not guessed",
    "source": "A[^a]\n\n[^a]: First\n[^a]: Second",
    "selection": "A[^a]",
    "expected": "A[^a]"
  },
  {
    "name": "identical duplicate definitions copy only once",
    "source": "A[^a]\n\n[^a]: Same\n[^a]: Same",
    "selection": "A[^a]",
    "expected": "A[^a]\n\n[^a]: Same"
  }
]
